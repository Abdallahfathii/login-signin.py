# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for local SQLite; set for PostgreSQL (docker-compose sets this)
# DATABASE_URL=postgres://auth:auth@localhost:5432/authdb
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password-reset emails — base URL of the frontend (used in reset links)
FRONTEND_URL=http://localhost:5173

# Email delivery. Leave EMAIL_HOST empty to use the console backend
# (reset links print to the Django server terminal — fine for local dev).
# For real delivery, set these to your SMTP provider (e.g. Gmail, SendGrid).
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
